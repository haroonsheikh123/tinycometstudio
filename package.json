{
  "name": "tinycometstudio",
  "private": true,
  "description": "Tiny Comet Studio website — static site + Cloudflare Pages Functions. Zero dependencies.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "new-game": "node tools/new-game.mjs",
    "new-post": "node tools/new-post.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npx wrangler pages dev",
    "preview": "python3 -m http.server 8000 --directory public"
  },
  "dependencies": {
    "mysql2": "3.24.6"
  }
}
