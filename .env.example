# Tiny Comet Studio — settings for the Node.js / cPanel host.
# Put real values either in cPanel → Setup Node.js App → Environment variables, or in a private file
# ~/tinycomet-data/.env (outside public_html; `npm run setup` creates it with fresh secrets).
# Environment variables win over the file. Never commit real values. Cloudflare uses the same names.

# ---------------------------------------------------------------- secrets (required)
# Signs sessions, CSRF tokens, play cookies, uploads and the audit hash chain.   openssl rand -base64 48
SIGNING_KEY=
# Encrypts TOTP and webhook secrets at rest.                                       openssl rand -base64 32
ENCRYPTION_KEY=
# One-time token for /admin/setup (creating the first owner).                       openssl rand -hex 24
SETUP_TOKEN=
# Cloudflare Turnstile (free, works on any host): secret here, site key in Admin › Settings.
# Test keys that always pass: site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=

# ---------------------------------------------------------------- database
# sqlite (a file, needs Node 22.13+) | mysql (cPanel MySQL/MariaDB, any Node 18+) | auto (default: mysql if configured)
DB_DRIVER=auto
# SQLite file (default ~/tinycomet-data/site.db)
# SQLITE_FILE=~/tinycomet-data/site.db
# MySQL/MariaDB — cPanel → MySQL Databases (names get your cPanel username prefix, e.g. myuser_tinycomet)
# DATABASE_URL=mysql://myuser_tinycomet:PASSWORD@localhost:3306/myuser_tinycomet
#   (URL-encode special characters in the password: @ → %40, # → %23, / → %2F)
# or separately: MYSQL_HOST=localhost  MYSQL_PORT=3306  MYSQL_USER=  MYSQL_PASSWORD=  MYSQL_DATABASE=  MYSQL_SOCKET=

# ---------------------------------------------------------------- folders
# Private data: database file, uploaded media, render cache, backups, .env (default ~/tinycomet-data)
# DATA_DIR=~/tinycomet-data
# MEDIA_DIR=~/tinycomet-data/media
# RENDER_CACHE_DIR=~/tinycomet-data/cache      (off = memory only)

# ---------------------------------------------------------------- site
ENVIRONMENT=production
SITE_URL=https://tinycometstudio.com
# How long a solved captcha unlocks web play (hours, max 24)
PLAY_TTL_HOURS=4
# Hostnames Turnstile tokens may come from (comma-separated). Empty = the request's own host.
ALLOWED_HOSTNAMES=
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# ---------------------------------------------------------------- web server
# Passenger sets PORT itself. Locally: node server.mjs listens on 3000.
# PORT=3000
# Behind cPanel's Apache/Passenger the defaults are right. TRUST_PROXY = proxy hops to trust in X-Forwarded-For
# (a number, or a list of proxy IPs/CIDRs). Passenger's own secure client-address header is always used when present.
# TRUST_PROXY=1
# Using Cloudflare DNS (orange cloud) in front? Then real visitor IPs + country come from Cloudflare's headers.
TRUST_CLOUDFLARE=false
# Redirect http → https in the app too (cPanel's "Force HTTPS Redirect" switch does the same).
FORCE_HTTPS=false
# Largest accepted request body in MB (game build zips are up to 100 MB).
MAX_BODY_MB=110
# Housekeeping while the app is awake (scheduled posts, webhook retries); 0 = only the cron job.
TICK_INTERVAL_MINUTES=5
# Create tables / import content/ automatically at start-up (safe; never overwrites).
AUTO_MIGRATE=true
AUTO_SEED=true
# Password hashing cost (PBKDF2-SHA256). 600000 = OWASP 2023. Use 100000 if you plan to move to Cloudflare.
PBKDF2_ITERATIONS=600000
# debug | info | warn | error — JSON lines in the app's stderr.log. LOG_REQUESTS=true logs every request.
LOG_LEVEL=info
LOG_REQUESTS=false

# ---------------------------------------------------------------- email (optional, off by default)
# Send invites and password resets from a cPanel mailbox (Email Accounts → Connect Devices shows these).
# SMTP_HOST=mail.tinycometstudio.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=hello@tinycometstudio.com
# SMTP_PASSWORD=
# EMAIL_FROM=Tiny Comet Studio <hello@tinycometstudio.com>
# …or any HTTPS relay: EMAIL_WEBHOOK_URL= / EMAIL_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- optional: Cloudflare cache purge when content changes
# CF_ZONE_ID=
# CF_API_TOKEN=
